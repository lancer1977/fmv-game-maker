{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/lancer1977/fmv-game-maker/schema/adventure.schema.json",
  "title": "FMV Game Maker adventure V1",
  "type": "object",
  "required": ["id", "title", "version", "start", "nodes"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "version": { "const": 1 },
    "start": { "type": "string", "minLength": 1 },
    "assetsBase": { "type": "string" },
    "nodes": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/node" }
    }
  },
  "$defs": {
    "fallback": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "bg": { "type": "string" },
        "title": { "type": "string" },
        "subtitle": { "type": "string" }
      }
    },
    "prompt": {
      "type": "object",
      "required": ["atMs", "windowMs", "input"],
      "additionalProperties": false,
      "properties": {
        "atMs": { "type": "number", "minimum": 0 },
        "windowMs": { "type": "number", "exclusiveMinimum": 0 },
        "input": {
          "type": "string",
          "enum": ["ArrowUp", "ArrowDown", "ArrowLeft", "ArrowRight"]
        },
        "label": { "type": "string" }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": { "type": "string", "enum": ["scene", "death"] },
        "clip": { "type": "string" },
        "fallback": { "$ref": "#/$defs/fallback" },
        "durationMs": { "type": "number", "exclusiveMinimum": 0 },
        "checkpoint": { "type": "boolean" },
        "prompt": { "$ref": "#/$defs/prompt" },
        "onSuccess": { "type": "string" },
        "onFail": { "type": "string" },
        "onTimeout": { "type": "string" },
        "onComplete": { "type": "string" }
      }
    }
  }
}
